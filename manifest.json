{
  "manifest_version": 3,
  "name": "Lead generator",
  "version": "3.1.0",
  "environment": "",
  "description": "Lead generator is a straightforward tool for extracting data about individuals directly from a LinkedIn Sales Navigator page.",
  "permissions": ["activeTab", "scripting", "identity", "tabs"],
  "host_permissions": ["https://www.linkedin.com/sales/*"],
  "icons": {
    "16": "assets/icons/logo-16.png",
    "32": "assets/icons/logo-32.png",
    "48": "assets/icons/logo-48.png",
    "128": "assets/icons/logo-128.png"
  },
  "background": {
    "service_worker": "src/scripts/worker/background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Lead generator",
    "default_icon": {
      "16": "assets/icons/logo-16.png",
      "32": "assets/icons/logo-32.png",
      "48": "assets/icons/logo-48.png",
      "128": "assets/icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-scripts/content.js"]
    }
  ],
  "oauth2": {
    "client_id": "703234486224-21msoego155lmcgk9h4u7778oo4css2h.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/cloud-translation"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

{
  "manifest_version": 3,
  "name": "Lead generator",
  "version": "3.3.8",
  "environment": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "lead-generator@future-processing.com",
      "strict_min_version": "128.0"
    }
  },
  "description": "Lead generator is a straightforward tool for extracting data about individuals directly from a LinkedIn Sales Navigator page.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/sales/lead/*",
    "https://www.linkedin.com/company/*",
    "https://lead-generator-backend-worker.vitalij-musko.workers.dev"
  ],
  "icons": {
    "16": "assets/icons/logo-16.png",
    "32": "assets/icons/logo-32.png",
    "48": "assets/icons/logo-48.png",
    "128": "assets/icons/logo-128.png"
  },
  "background": {
    "service_worker": "src/scripts/workers/background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Lead generator",
    "default_icon": {
      "16": "assets/icons/logo-16.png",
      "32": "assets/icons/logo-32.png",
      "48": "assets/icons/logo-48.png",
      "128": "assets/icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content-scripts/common/constants.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}

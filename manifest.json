{
  "manifest_version": 3,
  "name": "Lead generator",
  "version": "1.0",
  "description": "Lead generator extension for getting needed data",
  "permissions": ["activeTab", "tabs", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lead generation for getting needed data"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "handlerData.js"]
    }
  ]
}
